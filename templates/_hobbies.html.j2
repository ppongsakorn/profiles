{% macro hob(slug) %}<svg class="hobby-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">{% if slug == 'badminton' %}<circle cx="12" cy="17.5" r="3.2"/><path d="M9.6 15.4 6 4M12 14.3V3M14.4 15.4 18 4"/>{% elif slug == 'table-tennis' %}<circle cx="10" cy="10" r="6"/><path d="m14.5 14.5 6 6"/><circle cx="19" cy="5" r="1.6"/>{% elif slug == 'cycling' %}<circle cx="6" cy="16" r="3.6"/><circle cx="18" cy="16" r="3.6"/><path d="M6 16 10 8h5l3 8M10 8 12.5 16M14 6h2.5"/>{% elif slug == 'food-hunting' %}<path d="M4 12h16a8 8 0 0 1-16 0ZM8 6c0 1.5 1.5 1.5 1.5 3M12 5c0 1.5 1.5 1.5 1.5 3M16 6c0 1.5 1.5 1.5 1.5 3"/>{% else %}<path d="M5 5h14l-2 14a2 2 0 0 1-2 1.5H9A2 2 0 0 1 7 19L5 5ZM6.2 10h11.6"/>{% endif %}</svg>{% endmacro %}
{% for h in hobbies %}<span class="chip hobby">{{ hob(h.slug) }}{{ h.name }}</span>{% endfor %}