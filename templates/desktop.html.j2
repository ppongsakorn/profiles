<!doctype html>
<html lang="{{ lang }}"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<script>try{if(matchMedia('(max-width:640px)').matches&&localStorage.getItem('fullweb')!=='1')location.replace('{{ link(prefix ~ "m/") }}')}catch(e){}</script>
<title>{{ b.name }} — {{ hero_line }}</title>
<meta name="description" content="{{ hero_text | truncate(150) }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ link('assets/base.css') }}"><link rel="stylesheet" href="{{ link('assets/desktop.css') }}"><link rel="stylesheet" href="{{ link('assets/timeline.css') }}">
{{ jsonld }}
<link rel="alternate" type="application/json" href="{{ link('profile.json') }}">
<script defer src="{{ link('assets/webmcp.js') }}" data-profile="{{ link('profile.json') }}"></script>
<script defer src="{{ link('assets/timeline.js') }}"></script>
<link rel="icon" type="image/svg+xml" href="{{ link('assets/favicon.svg') }}">
</head><body>
{% include "_mockbar.html.j2" %}
<header class="site-header"><div class="wrap">
 <a class="brand" href="#top">{{ b.name }}</a>
 <nav class="nav">
  <a href="#focus">{{ ui.nav_focus }}</a><a href="#experience">{{ ui.experience }}</a><a href="#stack">{{ ui.stack_title }}</a><a href="#projects">{{ ui.projects }}</a><a href="#resume">{{ ui.resume }}</a><a href="#contact">{{ ui.contact }}</a>
  <a class="to-mobile" href="{{ link(prefix ~ 'm/') }}" onclick="try{localStorage.removeItem('fullweb')}catch(e){}">{{ ui.mobile_ver }}</a>
  <a class="lang" href="{{ link(alt_path) }}" hreflang="{{ alt_lang }}">{{ alt_lang | upper }}</a>
 </nav></div></header>
<main id="top" class="wrap">
 <div class="hero">
  <div><h1>{{ b.name }}</h1><p class="role">{{ hero_line }}</p><p>{{ hero_text }}</p>
   <div class="btns"><a class="btn primary" href="#resume">{{ ui.cta_resume }} →</a><a class="btn" href="#contact">{{ ui.cta_contact }}</a></div></div>
  {{ wheel }}
 </div>
 <section id="focus"><h2>{{ ui.focus }}</h2><div class="grid3">
  {% for f in focus %}<div class="focus-card f{{ loop.index }}" id="f-{{ f.slug }}"><h3>{{ f.title }}</h3><p>{{ f.desc }}</p></div>{% endfor %}
 </div></section>
 <section id="snapshot"><h2>{{ ui.snapshot }}</h2>{% include "_snapshot.html.j2" %}{% include "_docs_links.html.j2" %}</section>
 <section id="experience"><h2>{{ ui.story }}</h2><p class="sub">{{ ui.story_sub }}</p>{% include "_story.html.j2" %}</section>
 <section id="stack"><h2>{{ ui.stack_title }}</h2><p class="sub">{{ ui.stack_sub }}</p>{% include "_stackmap.html.j2" %}</section>
 {% if projects %}<section id="projects"><h2>{{ ui.projects }}</h2><div class="grid3">
  {% for p in projects %}<div class="card proj{% if p.in_preparation %} coming{% endif %}"><h3>{{ p.name }}</h3>{% if p.in_preparation %}<span class="badge soft">{{ ui.prep }}</span>{% endif %}<p>{{ p.summary }}</p>{% if p.mock %}<div class="mock-block"><span class="badge mock">{{ ui.mock }}</span>{% if p.mock.problem %}<p><b>{{ ui.f_problem }}</b> {{ p.mock.problem }}</p>{% endif %}{% if p.mock.actions %}<ul>{% for a in p.mock.actions %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}{% if p.mock.result %}<p><b>{{ ui.impact }}</b> {{ p.mock.result }}</p>{% endif %}</div>{% endif %}{% for s in p.stack %}<span class="chip">{{ s }}</span>{% endfor %}</div>{% endfor %}
 </div></section>{% endif %}
 <section id="resume"><h2>{{ ui.resume }}</h2><div class="card">
  {% for r in resumes %}<div class="resume-row"><b>{{ r.title }}</b><span>{% for f in r.formats %}<a href="{{ link(r.slug ~ '/resume.' ~ f) }}">{{ f | upper }}</a>{% endfor %}</span></div>{% endfor %}
 </div></section>
 <section><h2>{{ ui.interests }}</h2><p>{% for i in interests %}<span class="chip">{{ i }}</span>{% endfor %}</p>{% if hobbies %}<h2 style="margin-top:22px">{{ ui.hobbies }}</h2><p>{% include "_hobbies.html.j2" %}</p>{% endif %}</section>
</main>
<footer id="contact"><div class="wrap"><h2>{{ ui.contact }}</h2>
 <p>{{ [b.email, b.location] | select | join(' · ') }}{% for l in b.links %} · <a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</p>
 {% if not b.email %}<p class="prep"><b>{{ ui.prep }}</b> · {{ ui.m_email }} — {{ ui.contact_prep }}</p>{% endif %}
 <p class="muted">{{ ui.agents }} <a href="{{ link('profile.json') }}">profile.json</a> · <a href="{{ link('llms.txt') }}">llms.txt</a> · WebMCP</p></div></footer>
</body></html>
