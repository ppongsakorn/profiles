<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ b.name }}</title>
<style>body{font:16px/1.6 -apple-system,"Segoe UI",sans-serif;max-width:760px;margin:3rem auto;padding:0 1rem;color:#1a1a1a}
a{color:#0b5fff}h1{margin-bottom:0}.l{color:#0b5fff;font-weight:600}li{margin:.3rem 0}.m{color:#666;font-size:13px}</style></head><body>
<h1>{{ b.name }}</h1><div class="l">{{ b.label }}</div>
<p>{{ summary }}</p>
<h2>Resumes</h2><ul>
{% for r in resumes %}<li><b>{{ r.title }}</b> —
{% for f in r.formats %}<a href="{{ r.slug }}/resume.{{ f }}">{{ f | upper }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</li>{% endfor %}</ul>
<h2>Skills</h2>{% for g in skills %}<div><b>{{ g.group }}:</b> {{ g.list | join(', ') }}</div>{% endfor %}
<h2>Projects</h2>{% for p in projects %}<p><b>{{ p.name }}</b> <span class="m">{{ p.stack | join(' · ') }}</span><br>{{ p.summary }}</p>{% endfor %}
<p>{% for l in b.links %}<a href="{{ l.url }}">{{ l.label }}</a> {% endfor %}</p>
</body></html>
