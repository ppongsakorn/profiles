{% macro ico(n) %}<svg viewBox="0 0 24 24" aria-hidden="true">{% if n=='home' %}<path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>{% elif n=='work' %}<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>{% elif n=='resume' %}<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h7"/>{% elif n=='contact' %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>{% else %}<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>{% endif %}</svg>{% endmacro %}
<!doctype html>
<html lang="{{ lang }}"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#245fa6">
<title>{{ b.name }} — {{ ui[screen] }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ link('assets/base.css') }}"><link rel="stylesheet" href="{{ link('assets/mobile.css') }}">
</head><body>
<div class="top"><span>{{ b.name }}</span><a href="{{ link(alt_path) }}" hreflang="{{ alt_lang }}">{{ alt_lang | upper }}</a></div>
<main>
{% if screen == 'home' %}
 <h1>{{ b.name }}</h1><p class="role">{{ b.label }}</p><p class="lead">{{ summary }}</p>
 <h2>{{ ui.focus }}</h2>
 <div class="list">{% for f in focus %}<div class="item f{{ loop.index }}"><span class="bar"></span><span><b>{{ f.title }}</b><small>{{ f.desc }}</small></span></div>{% endfor %}</div>
 <p><a class="pill" href="{{ link(prefix ~ 'm/resume/') }}">{{ ui.cta_resume }}</a><a class="pill" href="{{ link(prefix ~ 'm/contact/') }}">{{ ui.cta_contact }}</a></p>
{% elif screen == 'work' %}
 <h2>{{ ui.experience }}</h2>
 {% for e in experience %}<div class="block"><h3>{{ e.role }}</h3><div class="dates">{{ e.company }} · {{ e.start }} – {{ e.end }}</div>
  <ul>{% for x in e.bullets %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endfor %}
 <h2>{{ ui.projects }}</h2>
 {% for p in projects %}<div class="block"><h3>{{ p.name }}</h3><p>{{ p.summary }}</p>{% for s in p.stack %}<span class="chip">{{ s }}</span>{% endfor %}</div>{% endfor %}
 <h2>{{ ui.interests }}</h2><p>{% for i in interests %}<span class="chip">{{ i }}</span>{% endfor %}</p>
{% elif screen == 'resume' %}
 <h2>{{ ui.resume }}</h2>
 {% for r in resumes %}<div class="block"><h3>{{ r.title }}</h3><div class="links">{% for f in r.formats %}<a href="{{ link(r.slug ~ '/resume.' ~ f) }}">{{ f | upper }}</a>{% endfor %}</div></div>{% endfor %}
{% else %}
 <h2>{{ ui.contact }}</h2>
 <div class="block"><p>{{ [b.email, b.location] | select | join(' · ') }}</p><div class="links">{% for l in b.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</div></div>
{% endif %}
</main>
<nav class="tabs" aria-label="menu">
 {% for key, sub in [('home',''),('work','work/'),('resume','resume/'),('contact','contact/')] %}
 <a href="{{ link(prefix ~ 'm/' ~ sub) }}" {% if screen == key %}aria-current="page"{% endif %}>{{ ico(key) }}{{ ui['tab_' ~ key] }}</a>{% endfor %}
 <a href="{{ link(prefix) }}" onclick="try{localStorage.setItem('fullweb','1')}catch(e){}">{{ ico('full') }}{{ ui.full }}</a>
</nav></body></html>
