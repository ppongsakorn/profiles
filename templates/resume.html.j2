<!doctype html>
<html lang="{{ lang }}"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ v.title }}</title>
<style>
 :root{--ink:#1a1a1a;--mute:#555;--accent:#0b5fff}
 body{font:14px/1.5 -apple-system,"Segoe UI","Sarabun",sans-serif;color:var(--ink);max-width:820px;margin:2rem auto;padding:0 1rem}
 h1{margin:0;font-size:28px} .label{color:var(--accent);font-weight:600}
 h2{font-size:15px;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #ddd;padding-bottom:.2rem;margin-top:1.6rem}
 .meta,.dates,.stack{color:var(--mute);font-size:13px} ul{margin:.3rem 0 .8rem 1.2rem;padding:0}
 .row{display:flex;justify-content:space-between;gap:1rem} a{color:var(--accent)}
 @media print{body{margin:0;max-width:none}a{color:inherit;text-decoration:none}}
</style></head><body>
<header><h1>{{ b.name }}</h1><div class="label">{{ b.label }}</div>
<div class="meta">{{ [b.email, b.location] | select | join(' · ') }}
{% for l in b.links %} · <a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</div></header>
{% for s in v.sections %}
{% if s == 'summary' and summary %}<section><h2>{{ L.summary }}</h2><p>{{ summary }}</p></section>
{% elif s == 'skills' and skills %}<section><h2>{{ L.skills }}</h2>
 {% for g in skills %}<div><b>{{ g.group }}:</b> {{ g.list | join(', ') }}</div>{% endfor %}</section>
{% elif s == 'experience' and experience %}<section><h2>{{ L.experience }}</h2>
 {% for e in experience %}<div class="row"><b>{{ e.role }} — {{ e.company }}</b><span class="dates">{{ e.start }} – {{ e.end }}</span></div>
 <ul>{% for x in e.bullets %}<li>{{ x }}</li>{% endfor %}</ul>{% endfor %}</section>
{% elif s == 'projects' and projects %}<section><h2>{{ L.projects }}</h2>
 {% for p in projects %}<div><b>{{ p.name }}</b> <span class="stack">{{ p.stack | join(' · ') }}</span><div>{{ p.summary }}</div></div><br>{% endfor %}</section>
{% elif s == 'interests' and interests %}<section><h2>{{ L.interests }}</h2><p>{{ interests | join(' · ') }}</p></section>
{% endif %}{% endfor %}
</body></html>
